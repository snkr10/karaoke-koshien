generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  waiting
  in_progress
  finished
}

enum RoundMode {
  individual
  team
}

model Session {
  id         String        @id @default(uuid())
  roomCode   String        @unique @map("room_code")
  hostToken  String        @map("host_token")
  status     SessionStatus @default(waiting)
  createdAt  DateTime      @default(now()) @map("created_at")
  expiresAt  DateTime      @map("expires_at")

  participants Participant[]
  rounds       Round[]

  @@map("sessions")
}

model Participant {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  name        String
  active      Boolean  @default(true)
  avatarType  String?  @map("avatar_type") // "preset" | "photo"
  avatarValue String?  @map("avatar_value") @db.Text // presetの絵文字key、またはphotoのdata URL
  createdAt   DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberships PerformanceMember[]

  @@map("participants")
}

model Round {
  id          String    @id @default(uuid())
  sessionId   String    @map("session_id")
  roundNumber Int       @map("round_number")
  mode        RoundMode
  locked      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  performances Performance[]

  @@map("rounds")
}

model Performance {
  id         String   @id @default(uuid())
  roundId    String   @map("round_id")
  order      Int      @default(0)
  songTitle  String   @map("song_title")
  songArtist String?  @map("song_artist")
  rawScore   Decimal? @map("raw_score") @db.Decimal(5, 3)
  rankPoints Int?     @map("rank_points")
  createdAt  DateTime @default(now()) @map("created_at")

  round   Round               @relation(fields: [roundId], references: [id], onDelete: Cascade)
  members PerformanceMember[]

  @@map("performances")
}

model PerformanceMember {
  performanceId String @map("performance_id")
  participantId String @map("participant_id")

  performance Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([performanceId, participantId])
  @@map("performance_members")
}

model Song {
  id            String   @id @default(uuid())
  title         String
  artist        String
  damRank       Int      @map("dam_rank")
  damRequestNo  String?  @map("dam_request_no")
  scrapedAt     DateTime @map("scraped_at")

  @@index([scrapedAt])
  @@map("songs")
}
